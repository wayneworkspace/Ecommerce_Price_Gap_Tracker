# Copy file này thành .env (không commit .env lên git) rồi điền giá trị thật của máy bạn.

# --- Shopee crawler ---

# Đường dẫn tuyệt đối tới folder Chrome persistent profile dùng để giữ session
# đăng nhập Shopee giữa các lần chạy (xem Issue 1/2 trong docs/issues.md).
SHOPEE_USER_DATA_DIR=C:\path\to\your\Shopee Profile


# --- BigQuery warehouse ---

# ID của GCP project (KHÔNG phải tên hiển thị). Xem ở Cloud Console, hoặc chạy
# `gcloud config get-value project`.
GCP_PROJECT_ID=your-project-id

# Nơi BigQuery đặt dataset. Chọn gần Việt Nam để giảm độ trễ và tránh phí
# chuyển vùng. Đổi region sau khi đã tạo dataset là phải tạo lại từ đầu —
# BigQuery không cho move dataset giữa các region.
BQ_LOCATION=asia-southeast1

# Tên dataset chứa bảng raw. Mỗi tầng một dataset, tương ứng ba schema trong
# thiết kế cũ: raw -> staging -> mart.
BQ_DATASET_RAW=price_tracker_raw


# --- KHÔNG khai key ở đây ---
#
# Không có biến GOOGLE_APPLICATION_CREDENTIALS trong file này, và đó là cố ý.
#
# Xác thực bằng Application Default Credentials:
#     gcloud auth application-default login
#
# Credential sẽ nằm ở %APPDATA%\gcloud\application_default_credentials.json —
# NGOÀI repo, nên không có đường nào lọt lên GitHub. Thư viện google-cloud tự
# tìm thấy nó, không cần khai báo gì thêm.
#
# Chỉ tải service-account key JSON khi thật sự bắt buộc (Airflow chạy trong
# container ở tuần 5-6). Khi đó để file key NGOÀI thư mục repo và trỏ tới bằng
# đường dẫn tuyệt đối — đừng bao giờ đặt nó bên trong repo, kể cả khi đã có
# .gitignore, vì `git add -f` vẫn thêm được và một lần sơ ý là mất.
